{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/upload.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/ai",
      "dest": "api/ai.js"
    },
    {
      "src": "/api/upload",
      "dest": "api/upload.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
